{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://scacnet.cacsa.eu:1234/v1",
        "apiKey": "lm-studio",
        "timeout": 120000
      },
      "models": {
        "google/gemma-4-e4b": {
          "name": "Gemma 4 E4B (local)",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 14096,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "lmstudio/google/gemma-4-e4b"
}